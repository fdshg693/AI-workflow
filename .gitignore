# Repository-level ignores. Kept in sync by hand with the umbrella's .gitignore
# (fdshg693/AI); the umbrella's rules do not apply inside a submodule.

# env / secrets
*.env
.env
*.pem

# per-workflow settings (models, providers, limits); only config.example.toml is committed.
# See docs/coding-conventions.md
config.toml

# dependencies / build
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
node_modules/
*.egg-info/
.DS_Store

# local notes / scratch / logs
memo/
temp/
logs/
*.log
# skill-tools feedback (`--fb`)
fb/

# caches and local databases
.cache/
*.sqlite3
.codegraph/
.textgraph/

# this repository
sandbox/orchestrator/data/

# Claude Code: hooks installed by `just sub-agent-hooks-install` and local settings (generated)
.claude/settings.json
.claude/settings.local.json
.claude/hooks/
.claude/tasks/
# local hook selection (the committed sample is .claude/skill-tools.hooks.example.yaml)
.claude/skill-tools.hooks.yaml
.skill-tools/
